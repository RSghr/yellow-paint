[node name="Level09" type="Node3D"]
editor_description = "EXPLORATION level (No paint, no way / Curious / Explorer, everything else average). Long route: Start, R2, R3, R4, plank, Goal; each next landing only shows from the far end of the platform. Trap: an unpainted button next to R2's landing sinks R4. The Explorer presses it as soon as it runs out of painted spots, so leaning on its exploring ruins the run. Waystone over 22 m away (out of sight) until R4. Minimums are placeholders."
script = ExtResource("lvl_script")
level_name = "The Secret Room"
intro_text = "The path turns behind walls. Some testers won't take a step you didn't paint. Others touch everything, and not everything here is good for them."
tester_1 = "Cass Cene"
minimum_1 = 9
tester_2 = "Rhea Spawn"
minimum_2 = 7
tester_3 = "Bea Tah"
minimum_3 = 7


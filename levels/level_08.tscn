[node name="TrapButton" parent="Interactables" instance=ExtResource("btn")]
editor_description = "THE TRAP. Unpainted, nobody presses it... except the Explorer, the moment it has no painted spot left to go to (e.g. landing on R2 with nothing painted in sight). It sinks R4. Never paint it (painted buttons get pressed by everyone)."

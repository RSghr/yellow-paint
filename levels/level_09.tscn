[node name="Level09" type="Node3D"]
editor_description = "EXPLORATION level (No paint, no way / Curious / Explorer, everything else average). Long route: Start, R2, R3, R4, plank, Goal; each next landing only shows from the far end of the platform. Shortcut: the unpainted button at R2's east end raises a bridge from R2 to R4 (skips R3). Waystone over 22 m away (out of sight) until R4. Minimums are placeholders."
script = ExtResource("lvl_script")
level_name = "The Secret Room"
intro_text = "The path turns behind walls, and somewhere there's a secret. Some testers find everything. Some won't take a step you didn't paint."
tester_1 = "Cass Cene"
minimum_1 = 9
tester_2 = "Rhea Spawn"
minimum_2 = 7
tester_3 = "Bea Tah"
minimum_3 = 5

